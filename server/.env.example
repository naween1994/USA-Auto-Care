# Server Runtime Configuration
NODE_ENV=development
PORT=5000

# MongoDB Replica Set or MongoDB Atlas Connection URI (Replica Set required for multi-document ACID transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/usa_auto_care?replicaSet=rs0

# Authentication & Security Secrets (Replace with cryptographically random 64-byte hex strings in production)
JWT_SECRET=replace_with_secure_random_64_byte_hex_secret_in_production
JWT_EXPIRES_IN=12h
CSRF_SECRET=replace_with_secure_random_csrf_secret_in_production

# Allowed Frontend Origin for CORS & Socket.IO
CLIENT_ORIGIN=http://localhost:5173

# Configurable Persistent Photo Upload Directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# Business Defaults (Configurable via Settings UI)
BUSINESS_NAME=USA Auto Care
BUSINESS_LOCATION=Alawwa, Sri Lanka
BUSINESS_CURRENCY=LKR
BUSINESS_TIMEZONE=Asia/Colombo

BUSINESS_PHONE=0773995399 / 0703995399
BUSINESS_EMAIL=usaautocare66@gmail.com
